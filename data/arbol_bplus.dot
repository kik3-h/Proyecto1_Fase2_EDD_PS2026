digraph ArbolBPlus {
    // Configuracion del grafo
    node [shape=record, style=filled];
    rankdir=TB;
    splines=ortho;
    nodesep=0.5;
    ranksep=0.8;

    // Leyenda
    subgraph cluster_leyenda {
        label="Leyenda";
        style=dashed;
        ley1 [label="Nodo Interno", fillcolor=lightyellow, shape=box];
        ley2 [label="Nodo Hoja", fillcolor=lightgreen, shape=box];
        ley1 -> ley2 [style=dashed, color=blue, label="Enlace Hoja"];
    }

    nodo0 [label="<f0> Lácteos", fillcolor=lightyellow];
    nodo0 -> nodo1;
    nodo1 [label="{<f0> Alimentos|<f1> Bebidas|<f2> Enlatados|<f3> Granos}|<sig>", fillcolor=lightgreen];
    nodo0 -> nodo2;
    nodo2 [label="{<f0> Lácteos|<f1> Panadería|<f2> Snacks|<f3> prueba}|<sig>", fillcolor=lightgreen];

    // Subgrafo para alinear hojas horizontalmente
    {
        rank=same;
        nodo1;
        nodo2;
    }

    // Enlaces secuenciales entre hojas (flechas punteadas azules)
    // Demuestran el recorrido O(log N + K) del Arbol B+
    nodo1:sig -> nodo2:f0 [style=dashed, color=blue, penwidth=2.0, constraint=false, label="sig", fontcolor=blue];
}
